PORT=3000
NODE_ENV=development
# Orígenes permitidos para la API y los WebSockets, separados por coma.
# En producción es obligatorio (p. ej. https://app.botbite.com.mx).
CORS_ORIGINS=http://localhost:4200
# Número de proxies delante de la API (Railway/Render/Nginx = 1).
TRUST_PROXY=1

# JWT (mínimo 32 caracteres cada secreto; deben ser distintos)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# QR de las sucursales: sitio que redirige /m/<sucursal> a la página del mesero.
QR_BASE_URL=

# Firma de los avisos al servicio del mesero (mínimo 32 caracteres). Sin él no se envían.
BOT_WEBHOOK_SECRET=

# Exportar clientes a CSV desde el panel. En producción queda apagado si no se define:
# se enciende cuando el aviso de privacidad de BotBite cubra la exportación.
CUSTOMERS_EXPORT_ENABLED=

# Documentación de la API en /docs. En producción solo se publica si defines las dos.
DOCS_USER=
DOCS_PASSWORD=

# BASE DE DATOS
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=botbite-waiter-api-db
# SSL: por defecto activo en producción y con verificación del certificado.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Certificado CA (contenido PEM o ruta al archivo), si el proveedor lo requiere.
DB_SSL_CA=

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# RATE LIMITING (API)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_LOGIN_LIMIT=5
# Peticiones por minuto de cada llave del bot (no por IP)
THROTTLE_BOT_LIMIT=1000
