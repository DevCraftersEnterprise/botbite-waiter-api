{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/test"],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "setupFiles": ["<rootDir>/test/e2e-env.ts"],
  "collectCoverageFrom": ["src/**/*.(t|j)s"],
  "coverageDirectory": "<rootDir>/coverage-e2e",
  "testTimeout": 60000
}
