PORT=3000
NODE_ENV=development
# Orígenes permitidos para la API y los WebSockets, separados por coma.
# En producción es obligatorio (p. ej. https://app.botbite.com.mx).
CORS_ORIGINS=http://localhost:4200
# Número de proxies delante de la API (Railway/Render/Nginx = 1).
TRUST_PROXY=1
# URL del panel web (se usa en los enlaces al menú que envía el bot).
FRONTEND_URL=http://localhost:4200

OPENAI_API_KEY=

# TWILIO
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
# Valida la firma X-Twilio-Signature del webhook. Solo desactivar en local.
TWILIO_VALIDATE_SIGNATURE=true
# URL pública exacta que tiene configurada Twilio (sin /v1/...), si la API
# está detrás de un proxy que cambia el host o el protocolo.
TWILIO_WEBHOOK_BASE_URL=

# JWT (mínimo 32 caracteres cada secreto; deben ser distintos)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# BASE DE DATOS
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=botbite-waiter-api-db
# SSL: por defecto activo en producción y con verificación del certificado.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Certificado CA (contenido PEM o ruta al archivo), si el proveedor lo requiere.
DB_SSL_CA=

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# RATE LIMITING (API)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
THROTTLE_LOGIN_LIMIT=5

# RATE LIMITING (mensajes de WhatsApp por cliente)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=10
